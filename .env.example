# CIVNEXA Environment Configuration Template
# Copy this file to .env and configure for your local or production deployment.
# IMPORTANT: Never commit actual passwords or private keys to source control.

# ==============================================================================
# FRONTEND CONFIGURATION (Vite / React)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_TIMEOUT=15000

# ==============================================================================
# BACKEND CONFIGURATION (Spring Boot)
# ==============================================================================
SERVER_PORT=8080

# Database Connectivity (MySQL 8)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/civnexa_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=civnexa
SPRING_DATASOURCE_PASSWORD=civnexa_secret

# JPA & Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Flyway Migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# JWT Authentication
# Must be at least 256 bits (32 bytes) long for HMAC-SHA256
CIVNEXA_JWT_SECRET=civnexa_institutional_production_secure_jwt_secret_key_at_least_256_bits_length_for_hmac_sha256
CIVNEXA_JWT_EXPIRATION_MS=86400000

# Super Admin Initial Bootstrap Credentials (Created once on startup if not present)
CIVNEXA_INITIAL_ADMIN_EMAIL=admin@civnexa.edu
CIVNEXA_INITIAL_ADMIN_PASSWORD=Admin@SecurePass2026!

# Registration Policy (Enables/disables public self-registration)
CIVNEXA_ALLOW_PUBLIC_REGISTRATION=true

# Email Service (Mailpit local development or SMTP in production)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
CIVNEXA_MAIL_FROM=notifications@civnexa.edu
