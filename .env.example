# CIVNEXA Environment Configuration Template
# Copy this file to .env and configure for your local or production deployment.
# IMPORTANT: Never commit actual passwords or private keys to source control.

# ==============================================================================
# FRONTEND CONFIGURATION (Vite / React)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_TIMEOUT=15000

# ==============================================================================
# BACKEND CONFIGURATION (Spring Boot)
# ==============================================================================
SERVER_PORT=8080

# Database Connectivity (MySQL 8)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/civnexa_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=civnexa
SPRING_DATASOURCE_PASSWORD=civnexa_secret

# JPA & Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Flyway Migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# JWT Authentication
# Must be at least 256 bits (32 bytes) long for HMAC-SHA256
CIVNEXA_JWT_SECRET=civnexa_institutional_production_secure_jwt_secret_key_at_least_256_bits_length_for_hmac_sha256
CIVNEXA_JWT_EXPIRATION_MS=900000

# OTP HMAC-SHA256 Secret (Used for hashing student registration OTPs)
# CRITICAL: Must be at least 256 bits (32 bytes) long and MUST NOT match CIVNEXA_JWT_SECRET
CIVNEXA_OTP_HMAC_SECRET=civnexa_institutional_otp_hmac_secret_key_at_least_256_bits_for_sha256

# Super Admin Initial Bootstrap
# Initial administrator bootstrap is disabled by default.
# To initialize root administrator on first startup:
# 1. Set CIVNEXA_ENABLE_INITIAL_BOOTSTRAP=true
# 2. Set CIVNEXA_BOOTSTRAP_ADMIN_EMAIL=admin@institution.edu
# 3. Optional: Set CIVNEXA_BOOTSTRAP_ADMIN_PASSWORD (if empty, a secure 24-character password is generated to civnexa-bootstrap-admin.credential)
# Refuses to run if any SUPER_ADMIN already exists in the database.
CIVNEXA_ENABLE_INITIAL_BOOTSTRAP=false
CIVNEXA_BOOTSTRAP_ADMIN_EMAIL=
CIVNEXA_BOOTSTRAP_ADMIN_PASSWORD=
CIVNEXA_BOOTSTRAP_ADMIN_NAME=Platform Administrator

# Registration Policy (Enables/disables public student self-registration)
PUBLIC_REGISTRATION_ENABLED=true

# AI Intelligence Configuration (Gemini API or local deterministic fallback)
# Set CIVNEXA_AI_PROVIDER to GEMINI or LOCAL.
# If GEMINI is chosen without an API key, the system automatically falls back to LOCAL.
CIVNEXA_AI_PROVIDER=GEMINI
CIVNEXA_AI_API_KEY=
CIVNEXA_AI_MODEL=gemini-2.5-flash
CIVNEXA_AI_TIMEOUT_MS=10000

# Email Service (Mailpit for local development or SMTP in production)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
CIVNEXA_MAIL_ENABLED=true
CIVNEXA_MAIL_FROM=no-reply@civnexa.edu
